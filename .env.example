# =============================================================================
# Atlas — environment configuration
# Copy to `.env.local` and fill in. Only the Supabase block is required to run.
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
# From your Supabase project: Settings → API. Create the project in the
# ca-central-1 (Canada Central / Montréal) region for data residency (PRD §7).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LLM provider (OPTIONAL) -------------------------------------------------
# Powers AI summaries and the RAG chat. Without it, Atlas runs in "manual mode":
# you add transcripts/summaries by hand and search falls back to keyword-only.
#
# provider: "azure-openai" (recommended for Canada residency) or "openai"
ATLAS_LLM_PROVIDER=
# Azure: your resource endpoint, e.g. https://<resource>.openai.azure.com
# OpenAI/compatible: base URL, e.g. https://api.openai.com/v1 (or leave blank)
ATLAS_LLM_ENDPOINT=
ATLAS_LLM_API_KEY=
# Azure: the chat *deployment* name. OpenAI: the model id (e.g. gpt-4o-mini).
ATLAS_LLM_MODEL=
# Embeddings deployment/model. Must output 1536 dims (e.g. text-embedding-3-small)
# to match the pgvector column. Leave blank to disable semantic search.
ATLAS_EMBEDDING_MODEL=

# --- Speech-to-text provider (OPTIONAL) --------------------------------------
# Powers automatic transcription. Without it, paste transcripts manually.
# provider: "openai" (Whisper — easiest, reuse your OpenAI key) |
#           "deepgram" (adds speaker diarization) | "assemblyai"/"whisper-ca" (stubs)
#
# Fastest demo setup: set ATLAS_LLM_PROVIDER=openai with your OpenAI key, then
# set ATLAS_STT_PROVIDER=openai and paste the SAME key below — one key powers
# transcription, summaries, and embeddings.
ATLAS_STT_PROVIDER=
ATLAS_STT_API_KEY=
